# URL pública final del sitio (usada para SEO: canonical, sitemap, Open Graph).
# Cambiar antes de publicar en producción.
NEXT_PUBLIC_SITE_URL=https://www.grupoambientalcasanare.com

# Credenciales para el envío real de correos desde los formularios de
# "Contacto" y "Solicita tu recolección" (ver app/api/*/route.ts).
